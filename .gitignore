# ============================================================
# Kiz Capital — Battle of Bots
# Anything containing secrets, local-only state, or auto-generated data.
# ============================================================

# Secrets / env / credentials  --- NEVER commit
.env
.env.*
!.env.example
vps-access.local.md
allowed_emails.local.txt
auth.local.sqlite
auth.local.sqlite-*
*.pem
*.key
id_rsa*
id_ed25519*
secrets/
credentials.json
.aws/
.ssh/

# Supabase / Vercel CLI local state
.supabase/
.vercel/

# Data folder — lives in Supabase Storage, NOT in GitHub.
# Vercel deploy must not ship local JSONs (would be stale + exposes data).
data/

# Veredictos del Ultra Tribunal — fuente de verdad VERSIONADA (post_merge.py
# los lee cada ciclo CI). Solo los verdict_*.json; el resto de tribunal/data
# (expedientes, cachés) sigue fuera del repo.
!tribunal/data/
tribunal/data/*
!tribunal/data/verdict_*.json

# Auto-generated operational dashboards (regenerated by post_merge.py and
# promote_to_runbook.py each cycle — committing would churn every run).
SYNC_STATUS.md
RUNBOOK.md

# Catch-all for any stray artifacts
*.log
mirror.log
launchd.stdout.log
launchd.stderr.log

# macOS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*~

# Python caches
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node (in case)
node_modules/
data/_audit/
supabase/.temp/
config/vps_registry.local.json
# 2026-09-08: patron generico ademas de la ruta explicita de arriba. El repo es
# PUBLICO y la convencion `*.local.*` es donde viven las IPs, logins y notas que
# nunca deben commitearse; sin el patron, un overlay NUEVO (otro *.local.json o
# un *.local.md) se subiria por accidente al primer `git add -A`.
*.local.json
*.local.md
.vercel
.playwright-mcp/
vendor/.tmp.*

# Auditoria tecnica maestra: NUNCA al repo publico (contiene topologia y hallazgos de seguridad)
KIZ_CAPITAL_PLATFORM_MASTER_AUDIT.md

# Artefactos de pytest. El repo es PUBLICO: los .pyc y la cache de pytest no
# aportan nada y pueden filtrar rutas locales. (2026-09-08)
.pytest_cache/
tests/**/__pycache__/
*.pyc
